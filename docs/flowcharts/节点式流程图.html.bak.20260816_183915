<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>法智引擎 · LangGraph 多智能体节点式流程图</title>
<style>
    /* ===== Reset & Base ===== */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box
    }

    body {
      font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
      background: #0d141e;
      color: #e0e8f0;
      min-height: 100vh;
      overflow-x: auto
    }

    a {
      text-decoration: none;
      color: inherit
    }

    /* ===== Top Nav ===== */
    .topnav {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(13, 20, 30, 0.97);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(12px);
      padding: 0 32px;
      height: 52px;
      display: flex;
      align-items: center;
      gap: 8px
    }

    .topnav .brand {
      font-size: 16px;
      font-weight: 800;
      background: linear-gradient(135deg, #60c5fa, #a78bfa);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-right: 24px
    }

    .topnav a {
      font-size: 13px;
      font-weight: 600;
      padding: 6px 14px;
      border-radius: 8px;
      transition: all .2s;
      cursor: pointer
    }

    .topnav a:hover {
      background: rgba(255, 255, 255, 0.06)
    }

    .topnav .spacer {
      flex: 1
    }

    .topnav .stat {
      font-size: 11px;
      color: #5a6a7a
    }

    /* ===== Section ===== */
    section {
      padding: 48px 32px;
      min-width: 1200px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04)
    }

    .sec-head {
      display: flex;
      align-items: baseline;
      gap: 14px;
      margin-bottom: 6px
    }

    .sec-head h2 {
      font-size: 24px;
      font-weight: 800
    }

    .sec-head .sec-num {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 2px;
      padding: 3px 10px;
      border-radius: 4px
    }

    .sec-desc {
      font-size: 13px;
      color: #7a8a9a;
      margin-bottom: 20px;
      line-height: 1.7
    }

    .phase {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      padding: 3px 10px;
      border-radius: 4px;
      display: inline-block;
      margin-bottom: 8px
    }

    .ph-blue {
      background: rgba(96, 197, 250, 0.15);
      color: #60c5fa
    }

    .ph-orange {
      background: rgba(251, 146, 60, 0.15);
      color: #fb923c
    }

    .ph-yellow {
      background: rgba(251, 191, 36, 0.15);
      color: #fcd34d
    }

    .ph-green {
      background: rgba(52, 211, 153, 0.15);
      color: #34d399
    }

    .ph-purple {
      background: rgba(167, 139, 250, 0.15);
      color: #a78bfa
    }

    .ph-red {
      background: rgba(239, 68, 68, 0.15);
      color: #ef4444
    }

    .ph-pink {
      background: rgba(236, 72, 153, 0.15);
      color: #ec4899
    }

    .ph-cyan {
      background: rgba(34, 211, 238, 0.15);
      color: #22d3ee
    }

    /* ===== SVG Flowchart ===== */
    .svg-wrap {
      overflow: auto;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.01);
      padding: 20px
    }

    .svg-wrap svg {
      display: block;
      margin: 0 auto;
      min-width: 100%
    }

    .node-group {
      cursor: pointer;
      transition: filter .2s
    }

    .node-group:hover {
      filter: brightness(1.3)
    }

    .node-rect {
      stroke-width: 1.5;
      transition: stroke-width .2s
    }

    .node-group:hover .node-rect {
      stroke-width: 2.5
    }

    .node-label {
      font-size: 13px;
      font-weight: 600;
      text-anchor: middle;
      dominant-baseline: central;
      pointer-events: none;
      user-select: none
    }

    .node-sub {
      font-size: 10px;
      font-weight: 400;
      fill: #8a9aab;
      pointer-events: none
    }

    .click-hint {
      fill: #fbbf24;
      opacity: 0.7;
      animation: pulse 2s infinite
    }

    @keyframes pulse {

      0%,
      100% {
        opacity: 0.4;
        r: 4
      }

      50% {
        opacity: 0.8;
        r: 6
      }
    }

    .edge {
      fill: none;
      stroke-width: 1.5
    }

    .edge-normal {
      stroke: #4a6a8a
    }

    .edge-branch {
      stroke: #7a8a9a;
      stroke-dasharray: 5, 3
    }

    .edge-loop {
      stroke: #fb923c;
      stroke-width: 2;
      stroke-dasharray: 6, 3
    }

    .edge-success {
      stroke: #34d399
    }

    .edge-danger {
      stroke: #ef4444;
      stroke-dasharray: 5, 3
    }

    .edge-label {
      font-size: 10px;
      fill: #8a9aab;
      text-anchor: middle;
      pointer-events: none
    }

    .edge-label-loop {
      fill: #fb923c;
      font-weight: 600
    }

    .edge-label-danger {
      fill: #fca5a5;
      font-weight: 600
    }

    .edge-label-success {
      fill: #6ee7b7;
      font-weight: 600
    }

    /* Node type colors */
    .node-start .node-rect {
      fill: rgba(52, 211, 153, 0.12);
      stroke: #34d399
    }

    .node-start .node-label {
      fill: #6ee7b7
    }

    .node-process .node-rect {
      fill: rgba(96, 197, 250, 0.08);
      stroke: rgba(96, 197, 250, 0.4)
    }

    .node-process .node-label {
      fill: #c0d8ef
    }

    .node-decision .node-rect {
      fill: rgba(251, 191, 36, 0.08);
      stroke: rgba(251, 191, 36, 0.4)
    }

    .node-decision .node-label {
      fill: #fcd34d
    }

    .node-danger .node-rect {
      fill: rgba(239, 68, 68, 0.08);
      stroke: rgba(239, 68, 68, 0.4)
    }

    .node-danger .node-label {
      fill: #fca5a5
    }

    .node-success .node-rect {
      fill: rgba(52, 211, 153, 0.08);
      stroke: rgba(52, 211, 153, 0.4)
    }

    .node-success .node-label {
      fill: #6ee7b7
    }

    .node-end .node-rect {
      fill: rgba(167, 139, 250, 0.1);
      stroke: #a78bfa
    }

    .node-end .node-label {
      fill: #d4b5ff
    }

    .node-detail .node-rect {
      fill: rgba(255, 255, 255, 0.03);
      stroke: rgba(255, 255, 255, 0.12);
      stroke-dasharray: 3, 2
    }

    .node-detail .node-label {
      fill: #8a9aab
    }

    .node-orange .node-rect {
      fill: rgba(251, 146, 60, 0.08);
      stroke: rgba(251, 146, 60, 0.4)
    }

    .node-orange .node-label {
      fill: #fdba74
    }

    .node-purple .node-rect {
      fill: rgba(167, 139, 250, 0.08);
      stroke: rgba(167, 139, 250, 0.4)
    }

    .node-purple .node-label {
      fill: #c4b5fd
    }

    .node-green .node-rect {
      fill: rgba(52, 211, 153, 0.08);
      stroke: rgba(52, 211, 153, 0.4)
    }

    .node-green .node-label {
      fill: #6ee7b7
    }

    .node-blue .node-rect {
      fill: rgba(96, 197, 250, 0.08);
      stroke: rgba(96, 197, 250, 0.4)
    }

    .node-blue .node-label {
      fill: #93c5fd
    }

    .node-pink .node-rect {
      fill: rgba(236, 72, 153, 0.08);
      stroke: rgba(236, 72, 153, 0.4)
    }

    .node-pink .node-label {
      fill: #f9a8d4
    }

    .node-cyan .node-rect {
      fill: rgba(34, 211, 238, 0.08);
      stroke: rgba(34, 211, 238, 0.4)
    }

    .node-cyan .node-label {
      fill: #67e8f9
    }

    /* ===== Modal ===== */
    .modal-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.7);
      z-index: 9999;
      justify-content: center;
      align-items: flex-start;
      padding: 40px 20px;
      overflow-y: auto
    }

    .modal-overlay.active {
      display: flex;
      animation: fadeIn .2s
    }

    @keyframes fadeIn {
      from {
        opacity: 0
      }

      to {
        opacity: 1
      }
    }

    .modal-content {
      background: #1a2330;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      max-width: 800px;
      width: 100%;
      margin-bottom: 40px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
      animation: slideUp .3s
    }

    @keyframes slideUp {
      from {
        transform: translateY(30px);
        opacity: 0
      }

      to {
        transform: translateY(0);
        opacity: 1
      }
    }

    .modal-header {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 20px 24px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      position: sticky;
      top: 0;
      background: #1a2330;
      border-radius: 16px 16px 0 0;
      z-index: 10
    }

    .modal-header .m-icon {
      font-size: 24px
    }

    .modal-header h2 {
      font-size: 18px;
      font-weight: 700;
      flex: 1
    }

    .modal-header .m-type {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1px;
      padding: 3px 10px;
      border-radius: 4px
    }

    .modal-close {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.06);
      border: none;
      color: #8a9aab;
      font-size: 18px;
      cursor: pointer;
      transition: all .2s;
      display: flex;
      align-items: center;
      justify-content: center
    }

    .modal-close:hover {
      background: rgba(239, 68, 68, 0.2);
      color: #fca5a5
    }

    .modal-body {
      padding: 20px 24px;
      max-height: calc(100vh - 200px);
      overflow-y: auto
    }

    .modal-body::-webkit-scrollbar {
      width: 6px
    }

    .modal-body::-webkit-scrollbar-track {
      background: transparent
    }

    .modal-body::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.1);
      border-radius: 3px
    }

    .popup-section {
      margin-bottom: 20px
    }

    .popup-section h3 {
      font-size: 14px;
      font-weight: 700;
      margin-bottom: 8px;
      padding-left: 10px;
      border-left: 3px solid #60c5fa;
      color: #93c5fd
    }

    .popup-section h3.think {
      border-color: #fbbf24;
      color: #fcd34d
    }

    .popup-section h3.sol {
      border-color: #a78bfa;
      color: #c4b5fd
    }

    .popup-section h3.tech {
      border-color: #34d399;
      color: #6ee7b7
    }

    .popup-section h3.opt {
      border-color: #fb923c;
      color: #fdba74
    }

    .popup-section h3.iv {
      border-color: #ec4899;
      color: #f9a8d4
    }

    .popup-section h3.flow {
      border-color: #38bdf8;
      color: #7dd3fc
    }

    .popup-section h3.reuse {
      border-color: #c084fc;
      color: #d8b4fe
    }

    .popup-section p {
      font-size: 13px;
      line-height: 1.8;
      color: #b0c0d0
    }

    .popup-section ol {
      padding-left: 20px
    }

    .popup-section ol li {
      font-size: 13px;
      line-height: 1.8;
      color: #b0c0d0;
      margin-bottom: 4px
    }

    .qa-block {
      background: rgba(255, 255, 255, 0.03);
      border-radius: 8px;
      padding: 12px 16px;
      margin-bottom: 10px;
      border-left: 3px solid rgba(255, 255, 255, 0.1)
    }

    .qa-block .qa-q {
      font-size: 13px;
      font-weight: 600;
      color: #fcd34d;
      margin-bottom: 6px
    }

    .qa-block .qa-a {
      font-size: 13px;
      line-height: 1.8;
      color: #b0c0d0
    }

    .qa-block.interview {
      border-left-color: #ec4899
    }

    .qa-block.interview .qa-q {
      color: #f9a8d4
    }

    .cmp-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px
    }

    .cmp-table th {
      background: rgba(96, 197, 250, 0.1);
      padding: 8px 10px;
      text-align: left;
      color: #93c5fd;
      font-weight: 600;
      border-radius: 4px
    }

    .cmp-table td {
      padding: 8px 10px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      color: #b0c0d0;
      vertical-align: top
    }

    .cmp-table tr:hover td {
      background: rgba(255, 255, 255, 0.02)
    }

    .tag {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 10px;
      font-size: 10px;
      font-weight: 600;
      margin-right: 4px
    }

    .tag-rec {
      background: rgba(52, 211, 153, 0.15);
      color: #6ee7b7
    }

    .tag-alt {
      background: rgba(96, 197, 250, 0.15);
      color: #93c5fd
    }

    .loop-badge {
      display: inline-block;
      background: rgba(251, 146, 60, 0.15);
      color: #fdba74;
      padding: 3px 10px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 600;
      margin: 4px 0
    }

    /* ===== Cover ===== */
    .cover {
      text-align: center;
      padding: 80px 40px;
      min-height: 80vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center
    }

    .cover h1 {
      font-size: 48px;
      font-weight: 900;
      margin-bottom: 12px;
      background: linear-gradient(135deg, #60c5fa, #a78bfa, #f0abfc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent
    }

    .cover .subtitle {
      font-size: 18px;
      color: #7a8a9a;
      margin-bottom: 40px
    }

    .cover-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      text-align: left;
      max-width: 800px;
      width: 100%
    }

    .cover-card {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 14px;
      padding: 24px 20px;
      cursor: pointer;
      transition: all .2s
    }

    .cover-card:hover {
      background: rgba(255, 255, 255, 0.06);
      transform: translateY(-2px)
    }

    .cover-card .cc-tag {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 2px;
      margin-bottom: 6px
    }

    .cover-card .cc-title {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 8px
    }

    .cover-card .cc-desc {
      font-size: 13px;
      color: #8a9aab;
      line-height: 1.7
    }

    /* ===== Legend ===== */
    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin: 16px 0;
      padding: 12px 16px;
      background: rgba(255, 255, 255, 0.02);
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.06)
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      color: #8a9aab
    }

    .legend-swatch {
      width: 16px;
      height: 12px;
      border-radius: 3px;
      border: 1.5px solid
    }

    /* ===== Footer ===== */
    footer {
      padding: 32px;
      text-align: center;
      font-size: 12px;
      color: #4a5a6a;
      line-height: 1.8
    }

    footer a {
      color: #60c5fa;
      cursor: pointer
    }

    /* ===== Optimization Section ===== */
    .opt-card {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 16px
    }

    .opt-card h3 {
      font-size: 15px;
      font-weight: 700;
      margin-bottom: 10px;
      color: #fdba74
    }

    .opt-card .opt-issue {
      font-size: 13px;
      color: #fca5a5;
      margin-bottom: 8px;
      line-height: 1.7
    }

    .opt-card .opt-solution {
      font-size: 13px;
      color: #6ee7b7;
      line-height: 1.7
    }

    .opt-card .opt-detail {
      font-size: 12px;
      color: #b0c0d0;
      line-height: 1.8;
      margin-top: 8px
    }

    /* ===== Hint bar ===== */
    .hint-bar {
      background: rgba(251, 191, 36, 0.08);
      border: 1px solid rgba(251, 191, 36, 0.2);
      border-radius: 10px;
      padding: 10px 16px;
      margin-bottom: 16px;
      font-size: 12px;
      color: #fcd34d;
      display: flex;
      align-items: center;
      gap: 8px
    }

    /* ===== Light Theme Overrides ===== */
    [data-theme="light"] body {
      background: #f5f7fa;
      color: #1a2330
    }

    [data-theme="light"] .topnav {
      background: rgba(255, 255, 255, 0.97);
      border-bottom: 1px solid rgba(0, 0, 0, 0.08)
    }

    [data-theme="light"] .topnav .stat {
      color: #5a6a7a
    }

    [data-theme="light"] section {
      border-bottom: 1px solid rgba(0, 0, 0, 0.06)
    }

    [data-theme="light"] .sec-desc {
      color: #4a5a6a
    }

    [data-theme="light"] .svg-wrap {
      border: 1px solid rgba(0, 0, 0, 0.1);
      background: rgba(255, 255, 255, 0.6)
    }

    [data-theme="light"] .node-sub {
      fill: #6a7a8a
    }

    [data-theme="light"] .edge-label {
      fill: #5a6a7a
    }

    [data-theme="light"] .modal-overlay {
      background: rgba(0, 0, 0, 0.5)
    }

    [data-theme="light"] .modal-content {
      background: #ffffff;
      border: 1px solid rgba(0, 0, 0, 0.1)
    }

    [data-theme="light"] .modal-header {
      background: #ffffff;
      border-bottom: 1px solid rgba(0, 0, 0, 0.08)
    }

    [data-theme="light"] .modal-close {
      background: rgba(0, 0, 0, 0.06);
      color: #5a6a7a
    }

    [data-theme="light"] .popup-section p,
    [data-theme="light"] .popup-section ol li {
      color: #3a4a5a
    }

    [data-theme="light"] .qa-block {
      background: rgba(0, 0, 0, 0.03)
    }

    [data-theme="light"] .cmp-table td {
      color: #3a4a5a;
      border-bottom: 1px solid rgba(0, 0, 0, 0.06)
    }

    [data-theme="light"] .cover-card {
      background: rgba(0, 0, 0, 0.02);
      border: 1px solid rgba(0, 0, 0, 0.1)
    }

    [data-theme="light"] .cover-card:hover {
      background: rgba(0, 0, 0, 0.05)
    }

    [data-theme="light"] .cover .subtitle {
      color: #5a6a7a
    }

    [data-theme="light"] .legend {
      background: rgba(0, 0, 0, 0.02);
      border: 1px solid rgba(0, 0, 0, 0.08)
    }

    [data-theme="light"] .legend-item {
      color: #5a6a7a
    }

    [data-theme="light"] footer {
      color: #7a8a9a
    }

    [data-theme="light"] .opt-card {
      background: rgba(0, 0, 0, 0.02);
      border: 1px solid rgba(0, 0, 0, 0.08)
    }

    [data-theme="light"] .opt-card .opt-detail {
      color: #3a4a5a
    }

    [data-theme="light"] .hint-bar {
      background: rgba(251, 191, 36, 0.1);
      color: #b45309
    }

    [data-theme="light"] #theme-toggle {
      background: rgba(0, 0, 0, 0.06);
      border: 1px solid rgba(0, 0, 0, 0.12)
    }

    [data-theme="light"] svg text {
      fill: #1a2330
    }

    [data-theme="light"] .node-process .node-label {
      fill: #1e40af
    }

    [data-theme="light"] .node-decision .node-label {
      fill: #92400e
    }

    [data-theme="light"] .node-danger .node-label {
      fill: #991b1b
    }

    [data-theme="light"] .node-success .node-label {
      fill: #065f46
    }

    [data-theme="light"] .node-end .node-label {
      fill: #5b21b6
    }

    [data-theme="light"] .node-detail .node-label {
      fill: #4a5a6a
    }

    [data-theme="light"] .node-orange .node-label {
      fill: #9a3412
    }

    [data-theme="light"] .node-purple .node-label {
      fill: #5b21b6
    }

    [data-theme="light"] .node-green .node-label {
      fill: #065f46
    }

    [data-theme="light"] .node-blue .node-label {
      fill: #1e40af
    }

    [data-theme="light"] .node-pink .node-label {
      fill: #9d174d
    }

    [data-theme="light"] .node-cyan .node-label {
      fill: #155e75
    }

    [data-theme="light"] .node-start .node-label {
      fill: #065f46
    }

    [data-theme="light"] .edge-normal {
      stroke: #6a8aaa
    }

    [data-theme="light"] .modal-body::-webkit-scrollbar-thumb {
      background: rgba(0, 0, 0, 0.15)
    }
  </style>
</head>
