    /* ═══════════════════════════════════════════════════
       RENDERING ENGINE — SVG绘制引擎
       ═══════════════════════════════════════════════════ */

    /* 节点类型→CSS class 映射 */
    const TYPE_CLASS = {
      start: 'node-start', process: 'node-process', decision: 'node-decision',
      danger: 'node-danger', success: 'node-success', end: 'node-end',
      detail: 'node-detail', orange: 'node-orange', purple: 'node-purple',
      green: 'node-green', blue: 'node-blue', pink: 'node-pink', cyan: 'node-cyan'
    };

    /* 节点类型→中文标签 */
    const TYPE_LABEL = {
      start: '起始', process: '处理', decision: '判断',
      danger: '风险', success: '成功', end: '结束',
      detail: '数据', orange: '增强', purple: '聚合',
      green: '检索', blue: 'AI', pink: '交互', cyan: '问答'
    };

    /* 边类型→样式 class */
    const EDGE_CLASS = {
      normal: 'edge-normal', branch: 'edge-branch', loop: 'edge-loop',
      success: 'edge-success', danger: 'edge-danger'
    };

    /* ── 绘制单个节点 ── */
    function drawNode(svg, nodeDef, nodeData) {
      const cls = TYPE_CLASS[nodeData.y] || 'node-process';
      const g = el('g', { class: 'node-group ' + cls, 'data-id': nodeDef.id });
      g.setAttribute('transform', 'translate(' + nodeDef.x + ',' + nodeDef.y + ')');

      // 圆角矩形主体
      const rect = el('rect', { class: 'node-rect', width: nodeDef.w, height: nodeDef.h, rx: 10, ry: 10 });
      g.appendChild(rect);

      // 图标 + 标题
      const label = nodeData.t || nodeDef.id;
      const icon = nodeData.i || '';
      const textY = nodeDef.h / 2;

      if (icon) {
        // 图标和文字组合，整体居中
        const combined = icon + ' ' + label;
        const labelText = el('text', { class: 'node-label', x: nodeDef.w / 2, y: textY, 'font-size': '12px' }, combined);
        g.appendChild(labelText);
      } else {
        const labelText = el('text', { class: 'node-label', x: nodeDef.w / 2, y: textY }, label);
        g.appendChild(labelText);
      }

      // 点击提示（脉冲点）
      const hint = el('circle', { class: 'click-hint', cx: nodeDef.w - 12, cy: 12, r: 4 });
      g.appendChild(hint);

      // 点击事件
      g.addEventListener('click', function () { showPopup(nodeDef.id) });

      svg.appendChild(g);
    }

    /* ── 计算边的路径 ── */
    function getEdgePath(fromNode, toNode, edgeType) {
      const fx = fromNode.x + fromNode.w / 2;
      const fy = fromNode.y + fromNode.h;
      const tx = toNode.x + toNode.w / 2;
      const ty = toNode.y;

      // 自环（如数值校验重试）
      if (fromNode.id === toNode.id) {
        const cx = fromNode.x + fromNode.w;
        const cy = fromNode.y + fromNode.h / 2;
        return 'M' + cx + ',' + cy +
          ' C' + (cx + 40) + ',' + cy + ' ' + (cx + 40) + ',' + (cy + 30) + ' ' + cx + ',' + (cy + 30) +
          ' L' + (cx - 10) + ',' + (cy + 30);
      }

      // 同一列，正常向下
      if (Math.abs(fx - tx) < 30) {
        if (edgeType === 'loop') {
          // 回溯环：走一个弧线
          const midY = (fy + ty) / 2;
          const offset = 80;
          return 'M' + fx + ',' + fy +
            ' C' + (fx + offset) + ',' + midY + ' ' + (tx + offset) + ',' + midY + ' ' + tx + ',' + ty;
        }
        return 'M' + fx + ',' + fy + ' L' + tx + ',' + ty;
      }

      // 从决策节点分支出去（多条出边）
      if (edgeType === 'branch') {
        // 从节点底部出发，S曲线到目标
        const midY = (fy + ty) / 2;
        return 'M' + fx + ',' + fy +
          ' C' + fx + ',' + midY + ' ' + tx + ',' + midY + ' ' + tx + ',' + ty;
      }

      // 回溯环（如 retry → retrieval，向上回退）
      if (edgeType === 'loop') {
        // 从源节点右侧出发，弧线绕到目标节点右侧
        const sx = fromNode.x + fromNode.w;
        const sy = fromNode.y + fromNode.h / 2;
        const ex = toNode.x + toNode.w;
        const ey = toNode.y + toNode.h / 2;
        const arcW = 60;
        return 'M' + sx + ',' + sy +
          ' C' + (sx + arcW) + ',' + sy + ' ' + (ex + arcW) + ',' + ey + ' ' + ex + ',' + ey;
      }

      // danger 路径（如 retry≥3 → interrupt）
      if (edgeType === 'danger') {
        const midY = (fy + ty) / 2;
        const offset = Math.abs(fx - tx) / 2;
        return 'M' + fx + ',' + fy +
          ' C' + (fx + offset) + ',' + midY + ' ' + (tx - offset) + ',' + midY + ' ' + tx + ',' + ty;
      }

      // 普通连接
      if (fy < ty) {
        // 向下连接
        return 'M' + fx + ',' + fy + ' L' + tx + ',' + ty;
      } else {
        // 向上或同高连接
        const midY = (fy + ty) / 2;
        return 'M' + fx + ',' + fy +
          ' C' + fx + ',' + midY + ' ' + tx + ',' + midY + ' ' + tx + ',' + ty;
      }
    }

    /* ── 绘制边 ── */
    function drawEdge(svg, edge, nodes) {
      const fromNode = nodes[edge.from];
      const toNode = nodes[edge.to];
      if (!fromNode || !toNode) return;

      const edgeType = edge.type || 'normal';
      const pathD = getEdgePath(fromNode, toNode, edgeType);

      // 边路径
      const path = el('path', {
        class: 'edge ' + EDGE_CLASS[edgeType],
        d: pathD,
        'marker-end': 'url(#arrow-' + edgeType + ')'
      });
      svg.appendChild(path);

      // 边标签
      if (edge.label && edge.label.length > 0) {
        let labelX, labelY;
        const fx = fromNode.x + fromNode.w / 2;
        const fy = fromNode.y + fromNode.h;
        const tx = toNode.x + toNode.w / 2;
        const ty = toNode.y;

        if (edgeType === 'loop') {
          // 标签放在弧线右侧
          labelX = Math.max(fx, tx) + 50;
          labelY = (fy + ty) / 2;
        } else if (fromNode.id === toNode.id) {
          labelX = fromNode.x + fromNode.w + 50;
          labelY = fromNode.y + fromNode.h / 2 + 20;
        } else {
          labelX = (fx + tx) / 2;
          labelY = (fy + ty) / 2;
        }

        let labelClass = 'edge-label';
        if (edgeType === 'loop') labelClass += ' edge-label-loop';
        if (edgeType === 'danger') labelClass += ' edge-label-danger';
        if (edgeType === 'success') labelClass += ' edge-label-success';

        // 标签背景
        const labelBg = el('rect', {
          x: labelX - edge.label.length * 5 - 6,
          y: labelY - 8,
          width: edge.label.length * 10 + 12,
          height: 16,
          rx: 4, ry: 4,
          fill: 'rgba(13,20,30,0.85)',
          stroke: 'none'
        });
        svg.appendChild(labelBg);

        const label = el('text', { class: labelClass, x: labelX, y: labelY + 4 }, edge.label);
        svg.appendChild(label);
      }
    }

    /* ── 绘制完整图表 ── */
    function drawChart(chartKey) {
      const chart = CHARTS[chartKey];
      if (!chart) return;

      const svg = document.getElementById(chart.svgId);
      if (!svg) return;

      svg.setAttribute('viewBox', chart.viewBox);
      svg.innerHTML = '';

      // 定义箭头标记
      const defs = el('defs');
      const arrowTypes = ['normal', 'branch', 'loop', 'success', 'danger'];
      const arrowColors = {
        normal: '#4a6a8a', branch: '#7a8a9a', loop: '#fb923c',
        success: '#34d399', danger: '#ef4444'
      };
      arrowTypes.forEach(function (t) {
        const marker = el('marker', { id: 'arrow-' + t, viewBox: '0 0 10 10', refX: 8, refY: 5, markerWidth: 6, markerHeight: 6, orient: 'auto-start-reverse' });
        const path = el('path', { d: 'M 0 0 L 10 5 L 0 10 z', fill: arrowColors[t] });
        marker.appendChild(path);
        defs.appendChild(marker);
      });
      svg.appendChild(defs);

      // 构建节点查找表
      const nodeMap = {};
      chart.nodes.forEach(function (n) { nodeMap[n.id] = n });

      // 先画边（在节点下方）
      chart.edges.forEach(function (e) { drawEdge(svg, e, nodeMap) });

      // 再画节点（在边上方）
      chart.nodes.forEach(function (n) {
        const data = D[n.id];
        if (data) {
          drawNode(svg, n, data);
        } else {
          // 无数据的节点也画出来（占位）
          const g = el('g', { class: 'node-group node-detail', 'data-id': n.id });
          g.setAttribute('transform', 'translate(' + n.x + ',' + n.y + ')');
          const rect = el('rect', { class: 'node-rect', width: n.w, height: n.h, rx: 10, ry: 10 });
          g.appendChild(rect);
